<?xml version="1.0"?>
<package format="2">
  <name>sentry_chassis_controller</name>
  <version>0.1.0</version>
  <description>Template-based sentry steering chassis controller for ROS1 Noetic and Gazebo.</description>

  <maintainer email="maintainer@example.com">Sentry Controller Team</maintainer>
  <author email="maintainer@example.com">Sentry Controller Team</author>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>controller_interface</build_depend>
  <build_depend>hardware_interface</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>rm_chassis_controllers</build_depend>
  <build_depend>effort_controllers</build_depend>
  <build_depend>angles</build_depend>
  <build_depend>eigen</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>controller_interface</build_export_depend>
  <build_export_depend>hardware_interface</build_export_depend>
  <build_export_depend>pluginlib</build_export_depend>
  <build_export_depend>rm_chassis_controllers</build_export_depend>
  <build_export_depend>effort_controllers</build_export_depend>
  <build_export_depend>angles</build_export_depend>
  <build_export_depend>eigen</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>controller_interface</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>rm_chassis_controllers</exec_depend>
  <exec_depend>rm_msgs</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>angles</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rm_description</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <controller_interface plugin="${prefix}/sentry_chassis_controller_plugins.xml"/>
  </export>
</package>
